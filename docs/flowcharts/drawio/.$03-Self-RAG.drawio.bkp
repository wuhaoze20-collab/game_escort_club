<diagram id="page2" name="01 反思点1-检索前判断">
  <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1400" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="t2" value="反思点1 · 检索前判断（要不要查知识库）—— 代码依据 backend/api/ai_api.py L128~139 + backend/ai_service.py self_rag_should_retrieve() L827~866" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell>
      <mxCell id="p1" value="用户提问：POST /api/ai/chat" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="340" height="56" as="geometry"/></mxCell>
      <mxCell id="p2" value="读取开关 ai_self_rag_enabled&lt;br&gt;（ai_api.py L128 · 默认值见 config_service.py L379）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="340" height="81" as="geometry"/></mxCell>
      <mxCell id="d1" value="ai_self_rag_enabled&lt;br&gt;为真？（L131）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="p3" value="读取开关 ai_self_rag_retrieve_check&lt;br&gt;（L131 · 默认值见 config_service.py L383）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="470" width="340" height="60" as="geometry"/></mxCell>
      <mxCell id="d2" value="ai_self_rag_retrieve_check&lt;br&gt;为真？（L131）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="590" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="p4" value="调用大模型判断：&lt;br&gt;ai_service.self_rag_should_retrieve(&lt;br&gt;text, model=model)（L133）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="740" width="340" height="81" as="geometry"/></mxCell>
      <mxCell id="d3" value="返回的 need_retrieve&lt;br&gt;为真？（L134）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="880" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="p5" value="skip_rag = True（L134）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="1030" width="340" height="44" as="geometry"/></mxCell>
