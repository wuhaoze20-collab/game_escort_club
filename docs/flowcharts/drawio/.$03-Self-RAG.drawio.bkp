      <mxCell id="pEnd2" value="直接生成回答&lt;br&gt;（省 embedding 调用）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="1290" width="340" height="66" as="geometry"/></mxCell>
      <mxCell id="nSkip" value="跳过本次检索前判断&lt;br&gt;skip_rag 保持 False（默认值）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="337" width="340" height="60" as="geometry"/></mxCell>
      <mxCell id="p7" value="skip_rag = False&lt;br&gt;（need_retrieve 为真，照常检索）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="875" width="340" height="60" as="geometry"/></mxCell>
      <mxCell id="p8" value="照常走知识库检索：&lt;br&gt;ModularRAG.query()（backend/rag/pipeline.py）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1140" width="340" height="60" as="geometry"/></mxCell>
      <mxCell id="p9" value="进入检索 → 生成&lt;br&gt;（见 01-基础RAG 的「推理问答」页）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1290" width="340" height="66" as="geometry"/></mxCell>
      <mxCell id="err1" value="调用抛异常 → 打印「检索前判断失败，正常检索」&lt;br&gt;（ai_api.py L138~139）skip_rag 保持 False" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="380" height="60" as="geometry"/></mxCell>
      <mxCell id="nt1" value="判断链路全部内联在 backend/api/ai_api.py L128~139 里，&lt;br&gt;没有独立模块；判断器实现见 backend/ai_service.py&lt;br&gt;的 self_rag_should_retrieve()（L827~866）。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="360" height="102" as="geometry"/></mxCell>
      <mxCell id="nt2" value="判断器内部兜底（backend/ai_service.py）：&lt;br&gt;· 大模型调用失败 → need_retrieve=True（L852~853）&lt;br&gt;· 返回结果 JSON 解析失败 → need_retrieve=True（L863~866）&lt;br&gt;判不准时一律回退「照常检索」，宁可多查也不漏查。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="740" width="360" height="123" as="geometry"/></mxCell>
