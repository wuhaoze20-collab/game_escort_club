<diagram id="page3" name="02 反思点2-检索后相关性过滤">
  <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="2320" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="t3" value="反思点2 · 检索后相关性过滤（ISREL）—— 代码依据 backend/rag/pipeline.py 的 ④.5 段（L238~292）+ backend/ai_service.py self_rag_filter_relevance() L869~927" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell>
      <mxCell id="r0" value="④ 重排序完成&lt;br&gt;final_ordered 就绪（pipeline.py L215~236）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="380" height="56" as="geometry"/></mxCell>
      <mxCell id="r1" value="进入 ④.5 Self-RAG 相关性过滤（ISREL）&lt;br&gt;（pipeline.py L238）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="380" height="60" as="geometry"/></mxCell>
      <mxCell id="r2" value="读取开关 ai_self_rag_enabled（L241）&lt;br&gt;默认值见 config_service.py L379（False）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="380" height="60" as="geometry"/></mxCell>
      <mxCell id="d1" value="ai_self_rag_enabled 且&lt;br&gt;ai_self_rag_relevance_filter&lt;br&gt;都为真？（L242~244）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="440" height="150" as="geometry"/></mxCell>
      <mxCell id="eSkip" value="跳过 ISREL&lt;br&gt;沿用重排序结果" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="340" height="66" as="geometry"/></mxCell>
      <mxCell id="r3" value="遍历候选：final_ordered[:tk*2]，逐个处理（L252）&lt;br&gt;final_ordered 为空则整段跳过（L244）&lt;br&gt;（tk = 配置的 top_k，见 L156）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="580" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="d2" value="该候选的文本载体是哪一种？（L255~263）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="340" height="130" as="geometry"/></mxCell>
      <mxCell id="nFaq" value="FAQ 行 → 文本「问：… 答：…」（L257~258）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="320" height="44" as="geometry"/></mxCell>
      <mxCell id="nChunk" value="chunk 正文 → chunk.content（L259~260）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="900" width="320" height="44" as="geometry"/></mxCell>
      <mxCell id="nGraph" value="图谱事实 → graph_doc 的 content（L261~262）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="900" width="320" height="44" as="geometry"/></mxCell>
      <mxCell id="nOther" value="三种都不是 → continue&lt;br&gt;跳过该候选（L263~264）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="900" width="320" height="60" as="geometry"/></mxCell>
      <mxCell id="eOther" value="该候选被排除&lt;br&gt;不打分、也不进入最终结果" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="1030" width="320" height="66" as="geometry"/></mxCell>
      <mxCell id="nt2" value="代码注释（L246~249）：&lt;br&gt;三路来源的文本载体不同，都要认出来；&lt;br&gt;只认 chunk 的话，FAQ 行与图谱事实会被当成空文本&lt;br&gt;跳过打分，随后被过滤后的集合排除——&lt;br&gt;图谱事实就是这样被无声丢掉的。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1460" y="740" width="380" height="123" as="geometry"/></mxCell>
      <mxCell id="r5" value="得到该候选的文本 text（L258 / L260 / L262）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1030" width="340" height="44" as="geometry"/></mxCell>
      <mxCell id="d3" value="text 去空白后非空？（L265）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1140" width="340" height="110" as="geometry"/></mxCell>
      <mxCell id="eEmpty" value="空文本 → 跳过该候选&lt;br&gt;不进入打分集合（L265）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1150" width="340" height="66" as="geometry"/></mxCell>
      <mxCell id="r6" value="入列：candidate_texts.append(text[:300])&lt;br&gt;同时记下 candidate_keys（L266~267）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1300" width="380" height="60" as="geometry"/></mxCell>
      <mxCell id="d4" value="len(candidate_texts) &gt; 1？（L269）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1430" width="340" height="130" as="geometry"/></mxCell>
      <mxCell id="eFew" value="候选不足 2 条&lt;br&gt;跳过打分，保留原排序（L269）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1450" width="340" height="66" as="geometry"/></mxCell>
      <mxCell id="r7" value="读取阈值 ai_self_rag_relevance_threshold&lt;br&gt;（L271~272 · 默认值 3）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1600" width="380" height="60" as="geometry"/></mxCell>
      <mxCell id="r8" value="调用大模型逐条打 1~5 分：&lt;br&gt;ai_service.self_rag_filter_relevance(&lt;br&gt;……, threshold=rel_threshold)（L274~276）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1710" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="d5" value="filtered 非空？（L278）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1850" width="340" height="110" as="geometry"/></mxCell>
