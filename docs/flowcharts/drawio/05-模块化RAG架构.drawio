          <mxGeometry x="920" y="590" width="380" height="81" as="geometry" />
        </mxCell>
        <mxCell id="note_store" value="分层约定&lt;br&gt;· MySQL —— 业务真相源；图谱与向量库都由它派生&lt;br&gt;· 向量库 —— 只被 rag 的 VectorRetriever 读取&lt;br&gt;· Neo4j —— 图谱旁路，所有写入走 store.run_safe()，失败不致命&lt;br&gt;· 依赖单向：rag/graph_retriever.py → kg.store；kg 层不 import rag" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
