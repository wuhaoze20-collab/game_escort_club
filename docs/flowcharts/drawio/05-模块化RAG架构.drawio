        <mxCell id="kg_api" value="kg/api.py&lt;br&gt;FastAPI router，前缀 /api/kg&lt;br&gt;5 个端点：stats / graph / node / search / rebuild" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
