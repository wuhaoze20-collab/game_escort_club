        </mxCell>
        <mxCell id="caller_incr" value="main.py 启动 init_knowledge_graph()&lt;br&gt;下单 / 评价 / 打赏 / 提现 等接口&lt;br&gt;→ sync.sync_order / sync_rating / sync_tip / ..." style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
