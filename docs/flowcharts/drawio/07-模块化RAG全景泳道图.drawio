<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="drawio_kit" version="24.7.17" type="device">
<diagram id="swimlane" name="模块化RAG全景泳道图">
  <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1320" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>

      <!-- 标题 -->
      <mxCell id="title" value="模块化 RAG 全景泳道图：四个层级 × 从左到右查询流 × 开关与路径绑定（开走哪条路 / 关绕开哪步）—— 依据 backend/rag/*.py（13 模块）+ backend/kg/*.py（5 模块）" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2920" height="30" as="geometry"/></mxCell>

      <!-- ============ 泳道背景 ============ -->
      <mxCell id="lane1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2920" height="250" as="geometry"/></mxCell>
      <mxCell id="lane2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E0;strokeColor=#D79B00;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="2920" height="300" as="geometry"/></mxCell>
      <mxCell id="lane3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6E5;strokeColor=#82B366;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="2920" height="310" as="geometry"/></mxCell>
      <mxCell id="lane4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAF7;strokeColor=#9673A6;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="2920" height="280" as="geometry"/></mxCell>

      <!-- 泳道标签 -->
      <mxCell id="lane1lbl" value="层级 1 · 检索前&lt;br&gt;Pre-retrieval&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rag/query_rewriter.py&lt;br&gt;ai_rag.py（开关读取）&lt;br&gt;rag/pipeline.py（编排入口）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="150" height="130" as="geometry"/></mxCell>
      <mxCell id="lane2lbl" value="层级 2 · 检索中&lt;br&gt;Retrieval&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rag/vector_retriever.py&lt;br&gt;rag/keyword_retriever.py&lt;br&gt;rag/graph_retriever.py&lt;br&gt;rag/chroma_store.py&lt;br&gt;rag/qdrant_store.py&lt;br&gt;kg/store.py（→ Neo4j）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="150" height="200" as="geometry"/></mxCell>
      <mxCell id="lane3lbl" value="层级 3 · 检索后&lt;br&gt;Post-retrieval&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rag/fusion.py&lt;br&gt;rag/reranker.py&lt;br&gt;rag/cross_encoder_reranker.py&lt;br&gt;rag/context_builder.py&lt;br&gt;rag/image_captioner.py（旁路）&lt;br&gt;rag/document.py（数据载体）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="150" height="200" as="geometry"/></mxCell>
      <mxCell id="lane4lbl" value="层级 4 · 评估 / 生成&lt;br&gt;Generation &amp; Eval&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ai_service.py&lt;br&gt;（chat / 大模型生成 /&lt;br&gt;Self-RAG ISUSE 评估）&lt;br&gt;ai_rag.py（_fill_debug）&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1020" width="150" height="140" as="geometry"/></mxCell>

      <!-- ============ L1 检索前 ============ -->
      <mxCell id="n_in" value="用户提问&lt;br&gt;question + role + username" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="135" width="170" height="65" as="geometry"/></mxCell>

      <mxCell id="n_sw" value="读取 7 个模块开关&lt;br&gt;ai_rag.py module_*_enabled&lt;br&gt;（每次查询重新读）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="180" height="75" as="geometry"/></mxCell>

      <mxCell id="n_rw_switch" value="rag_module_&lt;br&gt;query_rewrite ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="125" width="150" height="85" as="geometry"/></mxCell>

      <mxCell id="n_rw_on" value="① 查询改写 QueryRewriter.rewrite()&lt;br&gt;同义扩展 / 分解 / 后退 / HyDE / 多查询&lt;br&gt;→ 产出 query_list[]（多个变体）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="115" width="220" height="85" as="geometry"/></mxCell>

      <mxCell id="n_rw_off" value="关：绕开改写&lt;br&gt;query_list = [原始问题]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;dashed=1;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="215" width="220" height="50" as="geometry"/></mxCell>

      <!-- ============ L2 检索中 ============ -->
      <mxCell id="n_multi" value="② 多路召回 Multi-Retrieval&lt;br&gt;每个 query 变体各跑一遍；&lt;br&gt;图谱只用原始问题" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="210" height="65" as="geometry"/></mxCell>

      <mxCell id="k_kw" value="KeywordRetriever.retrieve()&lt;br&gt;FAQ BM25（读 AiFaq）&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;开关 rag_module_keyword_retrieval&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;关 → 该路不跑&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="440" width="185" height="100" as="geometry"/></mxCell>

      <mxCell id="k_vec" value="VectorRetriever.retrieve()&lt;br&gt;document / image / faq 三通道&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;开关 rag_module_vector_retrieval&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ chroma_store / qdrant_store&lt;br&gt;关 → 该路不跑&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="440" width="200" height="100" as="geometry"/></mxCell>

      <mxCell id="k_graph" value="GraphRetriever.retrieve()&lt;br&gt;实体链接 → 一跳邻域&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;开关 rag_module_graph_retrieval&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ kg/store.py → Neo4j&lt;br&gt;关 → 该路不跑&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="440" width="200" height="100" as="geometry"/></mxCell>

      <mxCell id="n_empty" value="三路结果&lt;br&gt;全空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1820" y="425" width="130" height="110" as="geometry"/></mxCell>

      <mxCell id="n_ret_empty" value="返回空字符串&lt;br&gt;（不注入参考资料）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1810" y="565" width="150" height="45" as="geometry"/></mxCell>

      <!-- ============ L3 检索后（从左到右：融合→重排→Self-RAG→上下文构建） ============ -->
      <mxCell id="n_fuse" value="③ 结果融合 FusionModule.fuse()&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;开关 rag_module_fusion&lt;/font&gt;&lt;br&gt;开 → 加权 RRF（rag_rrf_k）&lt;br&gt;关 → pipeline._simple_merge()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2000" y="675" width="200" height="105" as="geometry"/></mxCell>

      <mxCell id="n_rerank" value="④ 重排序 Reranker / CrossEncoder&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;开关 rag_module_rerank&lt;/font&gt;&lt;br&gt;rule → Reranker.rerank()（默认）&lt;br&gt;semantic → CrossEncoderReranker（多1次API）&lt;br&gt;关 → 直接用融合结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="670" width="210" height="115" as="geometry"/></mxCell>

      <mxCell id="n_selfrag" value="④.5 Self-RAG 相关性过滤&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;开关 ai_self_rag_enabled&lt;/font&gt;&lt;br&gt;开 → self_rag_filter_relevance()&lt;br&gt;ISREL 打分 1~5，过滤 ≤ 阈值片段&lt;br&gt;关 → 绕开，直接进下一步" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2470" y="675" width="200" height="105" as="geometry"/></mxCell>

      <mxCell id="n_ctx" value="⑤+⑥ 调试信息 + 上下文构建&lt;br&gt;_fill_debug()（前端RAG调试页）&lt;br&gt;ContextBuilder.build()&lt;br&gt;渲染引用块（top_k / max_chars）&lt;br&gt;→ 返回格式化上下文 str" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2700" y="675" width="200" height="105" as="geometry"/></mxCell>

      <!-- ============ L4 评估 / 生成 ============ -->
      <mxCell id="n_gen" value="⑦ 生成 Generate（不在 ModularRAG）&lt;br&gt;ai_service.chat()：拼 Prompt → 千问大模型&lt;br&gt;context 拼进 Prompt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2700" y="1000" width="210" height="80" as="geometry"/></mxCell>

      <mxCell id="n_eval" value="⑧ 答案质量评估&lt;br&gt;Self-RAG：ISUSE / ISSUP / ISNEXT&lt;br&gt;（ai_self_rag_enabled 时启用）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2440" y="1000" width="220" height="80" as="geometry"/></mxCell>

      <mxCell id="n_ans" value="返回答案&lt;br&gt;给用户" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2440" y="1100" width="150" height="55" as="geometry"/></mxCell>

      <!-- ============ 注释 / 图例 ============ -->
      <mxCell id="note_sw" value="开关与路径绑定（核心）—— 每个开关决定走哪条路、关了绕开哪步&lt;br&gt;· rag_module_query_rewrite：开→QueryRewriter 产出 query_list；关→query_list=[原始问题] 直接检索&lt;br&gt;· rag_module_keyword_retrieval：开→BM25 召回；关→该路跳过&lt;br&gt;· rag_module_vector_retrieval：开→向量召回（chroma/qdrant）；关→该路跳过&lt;br&gt;· rag_module_graph_retrieval：开→Neo4j 图谱召回；关→该路跳过&lt;br&gt;· rag_module_fusion：开→加权 RRF；关→pipeline._simple_merge() 直接拼接&lt;br&gt;· rag_module_rerank：开→rule/semantic 重排；关→直接用融合结果（不重排）&lt;br&gt;· ai_self_rag_enabled：开→检索后相关性过滤 + 生成后答案评估；关→两端都绕开&lt;br&gt;· rag_rerank_mode：rule=本地规则重排（默认，无额外 API）；semantic=CrossEncoder 调大模型逐条打分（多 1 次 API 调用）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="240" y="1070" width="820" height="190" as="geometry"/></mxCell>

      <mxCell id="note_kg" value="kg/ 5 模块在查询路径中的位置&lt;br&gt;· kg/store.py —— GraphRetriever 连接 Neo4j（查询时读）&lt;br&gt;· kg/schema.py —— 节点/关系字典，sync 时用（查询时不读）&lt;br&gt;· kg/sync.py —— 从 MySQL 业务表增量同步到图谱（离线旁路）&lt;br&gt;· kg/api.py —— /api/kg 管理端点（stats/graph/node/search/rebuild）&lt;br&gt;· kg/__init__.py —— 包入口；依赖单向：rag/graph_retriever → kg.store，kg 不 import rag" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1070" width="620" height="160" as="geometry"/></mxCell>

      <mxCell id="legend" value="图例：实线 = 主流程；灰色虚线 = 开关关闭时的旁路 / 降级路径；橙色菱形 = 开关判断；绿框 = L3 检索后节点；青框 = 跨层外部服务（大模型）；紫框 = L4 评估" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#FFF9E6;strokeWidth=1;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#666666;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1740" y="1090" width="680" height="50" as="geometry"/></mxCell>

      <!-- ============ 连线 ============ -->
      <!-- L1 内部 -->
      <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_in" target="n_sw"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_sw" target="n_rw_switch"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" value="开" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;fontColor=#2F6B2F;" edge="1" parent="1" source="n_rw_switch" target="n_rw_on"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" value="关" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#999999;strokeWidth=1.2;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;dashed=1;fontColor=#666666;" edge="1" parent="1" source="n_rw_switch" target="n_rw_off"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- L1 → L2 -->
      <mxCell id="e5" value="query_list[]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_rw_on" target="n_multi"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e5b" value="原始问题" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#999999;strokeWidth=1.2;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_rw_off" target="n_multi"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- L2 内部 -->
      <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_multi" target="k_kw"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_multi" target="k_vec"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_multi" target="k_graph"><mxGeometry relative="1" as="geometry"/></mxCell>

      <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_kw" target="n_empty"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.15;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_vec" target="n_empty"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.35;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_graph" target="n_empty"><mxGeometry relative="1" as="geometry"/></mxCell>

      <mxCell id="e12" value="是（全空）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#B85450;" edge="1" parent="1" source="n_empty" target="n_ret_empty"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- L2 → L3：否，进入融合 -->
      <mxCell id="e13" value="否（有结果）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#82B366;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#2F6B2F;" edge="1" parent="1" source="n_empty" target="n_fuse"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- L3 内部：融合→重排→Self-RAG→上下文构建 -->
      <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_fuse" target="n_rerank"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_rerank" target="n_selfrag"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_selfrag" target="n_ctx"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- L3 → L4 -->
      <mxCell id="e17" value="context 拼进 Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n_ctx" target="n_gen"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- L4 内部：生成←评估→答案 -->
      <mxCell id="e18" value="生成答案" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_gen" target="n_eval"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e19" value="评估通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_eval" target="n_ans"><mxGeometry relative="1" as="geometry"/></mxCell>

      <!-- 空结果也直接到生成（不注入context） -->
      <mxCell id="e20" value="空 context → 仍生成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#B85450;strokeWidth=1.2;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;jumpStyle=arc;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#B85450;" edge="1" parent="1" source="n_ret_empty" target="n_gen"><mxGeometry relative="1" as="geometry"/></mxCell>

    </root>
