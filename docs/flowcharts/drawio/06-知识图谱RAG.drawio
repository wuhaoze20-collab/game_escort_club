        <mxCell id="a3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="③ 订单状态变化&lt;br&gt;order_api._kg_sync(db, order)&lt;br&gt;下单 / 接单 / 结单等状态变更处调用" vertex="1">
