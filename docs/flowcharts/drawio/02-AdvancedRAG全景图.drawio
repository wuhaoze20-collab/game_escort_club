      <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e31" value="开（默认 False）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e32" value="关" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4_fixed" target="l4_run"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4_run" target="l4_score"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4_score" target="l4_ab"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4_ab" target="l4_hist"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4_hist" target="l4_feedback"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e39" value="⑥ 改参数 → 重新抽题评估（闭环）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;dashed=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4_feedback" target="l4_fixed"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e40" value="评估逐题复用同一条「检索 + 生成」链路" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;dashed=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="l4_fixed"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="f1" value="依据文件（本题每个节点与箭头均可回溯到源码）：&lt;br&gt;backend/api/ai_api.py（Self-RAG 检索前判断 / 生成后回答验证）&lt;br&gt;backend/ai_service.py（build_system_prompt 的两种模式、chat）&lt;br&gt;backend/ai_rag.py（build_rag_context 兼容层 + 各参数读取函数）&lt;br&gt;backend/rag/pipeline.py（ModularRAG.query ①~⑥ 步）&lt;br&gt;backend/rag_eval.py、backend/api/ai_rag_api.py（评估接口与分层抽样）&lt;br&gt;backend/config_service.py（CONFIG_META 开关与出厂默认值）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="1180" height="165" as="geometry"/></mxCell>
      <mxCell id="f2" value="读图方向：用户查询进入 → 层级1 检索前优化 → 层级2 检索中（多路召回 + 加权 RRF 融合）→ 层级3 检索后优化 → 上下文构建 / 生成 → 层级4 量化评估。&lt;br&gt;每个优化点右侧的便签写「开 → 走哪条路径 / 关 → 绕过哪一步」；&lt;br&gt;框内出现的开关名、参数名、接口路径、模块文件名都保留源码英文原文；&lt;br&gt;所有默认值都取自 backend/config_service.py 的 CONFIG_META。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="1530" width="1100" height="102" as="geometry"/></mxCell>
      <mxCell id="f3" value="闭环：层级4 的⑥把诊断结论回灌到系统参数（CONFIG_META 里的开关），层级1~3 与 ModularRAG 每次查询都重新读取参数，&lt;br&gt;下一轮提问 / 评估立即生效 —— 即「评估 → 调参 → 再评估」。&lt;br&gt;虚线只用于旁路与回灌（非主链路）。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2400" y="1530" width="1180" height="81" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>
</mxfile>
