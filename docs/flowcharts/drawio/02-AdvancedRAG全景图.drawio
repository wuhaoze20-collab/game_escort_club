<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="drawio_kit" version="24.7.17" type="device">
<diagram id="page1" name="02 Advanced RAG 全景图（四层级单页）">
  <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3780" pageHeight="1740" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="title" value="Advanced RAG 全景图（单页 · 从左到右贯穿四个层级）｜ 依据 backend/rag/pipeline.py、backend/query_optimizer.py、backend/rag/*.py、backend/rag_eval.py、backend/api/ai_rag_api.py、backend/config_service.py" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="3520" height="40" as="geometry"/></mxCell>
      <mxCell id="g_l1" value="层级1 · 检索前优化 ｜ backend/query_optimizer.py、backend/rag/query_rewriter.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#595959;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="690" height="1370" as="geometry"/></mxCell>
      <mxCell id="l1_gate" value="rag_module_query_rewrite = ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_gate_n" value="开 → QueryRewriter.rewrite() 调 query_optimizer.generate_queries()，产出多个查询变体&lt;br&gt;关 → queries = [{query: 原问题, type: original}]，绕过整个查询优化器" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="200" width="310" height="102" as="geometry"/></mxCell>
      <mxCell id="l1_sum" value="generate_queries() 汇总查询变体" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="342" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_sum_n" value="返回 [{query, type, channels}]，按 query 文本去重；原问题始终保留&lt;br&gt;type 取值：original / rewritten / subquery / stepback / expanded / hyde&lt;br&gt;HyDE 只走向量通道（channels 仅 vector）&lt;br&gt;子问题数上限 ai_query_max_sub（未在 CONFIG_META 注册，代码兜底 3，范围 1~5）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="342" width="310" height="165" as="geometry"/></mxCell>
      <mxCell id="l1_rw" value="① 查询重写 rewrite_query()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="547" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_rw_n" value="开关 ai_query_rewrite_enabled（出厂默认 False）&lt;br&gt;开 → 调大模型把口语化问题改写成标准检索查询，type = rewritten&lt;br&gt;关 → 返回原问题，不产生改写变体（省一次大模型调用）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="547" width="310" height="144" as="geometry"/></mxCell>
      <mxCell id="l1_dc" value="② 子查询分解 decompose_query()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="731" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_dc_n" value="开关 ai_query_decompose_enabled（出厂默认 False）&lt;br&gt;开 → 基于「改写后的问题」拆成多个子问题（每行一个，上限 ai_query_max_sub），type = subquery&lt;br&gt;关 → 返回 [原问题]，不产生子查询" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="731" width="310" height="144" as="geometry"/></mxCell>
      <mxCell id="l1_sb" value="③ 后退提示 step_back_query()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="915" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_sb_n" value="开关 ai_query_stepback_enabled（出厂默认 False）&lt;br&gt;开 → 生成更抽象的后退问题以取回背景规则，type = stepback&lt;br&gt;关 → 返回空字符串，不追加该变体" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="915" width="310" height="123" as="geometry"/></mxCell>
      <mxCell id="l1_ex" value="④ 查询扩展 expand_query()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1078" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_ex_n" value="开关 ai_query_expand_enabled（出厂默认 False）&lt;br&gt;开 → 原问题 + 补充同义词关键词，type = expanded（关键词与向量两通道都用）&lt;br&gt;关 → 返回空字符串，不追加" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="1078" width="310" height="123" as="geometry"/></mxCell>
      <mxCell id="l1_hy" value="⑤ HyDE 假设文档 hyde_document()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1241" width="630" height="44" as="geometry"/></mxCell>
      <mxCell id="l1_hy_n" value="开关 ai_query_hyde_enabled（出厂默认 False）　开 → 先生成假设答案，再用答案措辞走向量检索，type = hyde（仅向量通道）　关 → 返回空字符串，不追加" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1305" width="630" height="60" as="geometry"/></mxCell>
      <mxCell id="g_l2" value="层级2 · 检索中优化 ｜ backend/rag/vector_retriever.py、keyword_retriever.py、graph_retriever.py、fusion.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#595959;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1130" y="120" width="690" height="1370" as="geometry"/></mxCell>
      <mxCell id="l2_gate" value="rag_module_* 三路召回开关" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="200" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l2_gate_n" value="rag_module_vector_retrieval / rag_module_keyword_retrieval / rag_module_graph_retrieval（出厂默认均 True）&lt;br&gt;关某一路 → 该路本轮不参与召回，其余照常；&lt;br&gt;每个查询变体再按自身 channels 决定走哪几路" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="200" width="310" height="123" as="geometry"/></mxCell>
      <mxCell id="l2_vec" value="向量检索 VectorRetriever" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="363" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l2_vec_n" value="参数 rag_vector_backend（默认 chroma，可选 qdrant / mysql）+ rag_chroma_candidates（默认 50，两个向量库共用）+ ai_rag_min_score（默认 0.35，低于此分的候选被丢弃）&lt;br&gt;开 → 问题向量化后查 HNSW 索引；document / image / faq 三通道各自独立召回&lt;br&gt;兜底：向量库异常自动回退 MySQL 全表扫描 _hits_from_mysql()" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="363" width="310" height="186" as="geometry"/></mxCell>
      <mxCell id="l2_am" value="AutoMerging 父子块合并（在向量检索内）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="589" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l2_am_n" value="参数 rag_module_automerge（出厂默认 True）+ rag_automerge_ratio（默认 0.5）&lt;br&gt;开 → 同一父块（整章）命中子块占比达标时改返回整章，保证上下文完整&lt;br&gt;关 → 直接返回命中的子块片段" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="589" width="310" height="123" as="geometry"/></mxCell>
      <mxCell id="l2_kw" value="关键词检索 KeywordRetriever" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="752" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l2_kw_n" value="参数 rag_keyword_limit（默认 20）&lt;br&gt;开 → 遍历启用 FAQ，用 ai_service._faq_score() 打分，返回 FAQ BM25 风格精确匹配&lt;br&gt;关 → 跳过该通道，只用其余几路" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="752" width="310" height="102" as="geometry"/></mxCell>
      <mxCell id="l2_gr" value="图谱检索 GraphRetriever" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="894" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l2_gr_n" value="参数 rag_graph_limit（默认 3）；还需图谱可用（kg_enabled 默认 True 且 Neo4j 连得上）&lt;br&gt;开 → 实体链接（账户名 / 订单号 / 昵称 / 游戏名 / 标签）→ 取一跳邻域 → 渲染事实；只吃原始问题，不跟查询变体分裂&lt;br&gt;关 / 未命中 → 返回空列表，不抛异常（RAG 少了这一路照样能答）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="894" width="310" height="165" as="geometry"/></mxCell>
      <mxCell id="l2_check" value="三路结果是否全空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="1099" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l2_check_n" value="依据 backend/rag/pipeline.py：三路命中全空时&lt;br&gt;直接返回空字符串，不注入任何参考资料" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="1099" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="l2_empty" value="返回空字符串&lt;br&gt;（不注入参考资料）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="1199" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="l2_fusion" value="加权 RRF 融合 FusionModule.fuse()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="1299" width="630" height="44" as="geometry"/></mxCell>
      <mxCell id="l2_fusion_n" value="参数 rag_rrf_k（默认 60）+ 通道权重 rag_weight_document 1.0 / image 1.1 / faq 1.2 / graph 1.3　｜　开（rag_module_fusion）→ 用排名算 RRF 分再乘通道权重，多路合并去重，输出 ordered + pool　｜　关 → _simple_merge()：图谱 → 向量 → 关键词直接拼接，不做 RRF 排序" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="1363" width="630" height="81" as="geometry"/></mxCell>
      <mxCell id="g_l3" value="层级3 · 检索后优化 ｜ backend/rag/reranker.py、cross_encoder_reranker.py、context_builder.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#595959;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1900" y="120" width="690" height="1370" as="geometry"/></mxCell>
      <mxCell id="l3_gate" value="rag_module_rerank = ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="200" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l3_gate_n" value="开 → 进入检索后重排序，模式由 rag_rerank_mode 决定（rule / semantic，默认 rule）&lt;br&gt;关 → final_ordered = ordered，rerank_type = off（直接用 RRF 融合结果）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2250" y="200" width="310" height="102" as="geometry"/></mxCell>
      <mxCell id="l3_rule" value="Reranker（规则式）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="342" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l3_rule_n" value="rag_rerank_mode = rule（出厂默认）&lt;br&gt;综合分 = RRF 归一化分 × rag_rerank_weight_rrf(0.4) + 向量最高分 × rag_rerank_weight_vec(0.3) + 关键词归一化分 × rag_rerank_weight_kw(0.15) + FAQ 来源加成 rag_rerank_source_bonus(0.1) + 标题匹配加分（最多 0.05）&lt;br&gt;不调外部 API，纯规则实时计算" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2250" y="342" width="310" height="165" as="geometry"/></mxCell>
      <mxCell id="l3_sem" value="CrossEncoderReranker（语义级）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="547" width="260" height="44" as="geometry"/></mxCell>
      <mxCell id="l3_sem_n" value="rag_rerank_mode = semantic&lt;br&gt;取前 rag_rerank_candidate_limit（默认 10）条候选，调大模型逐条打相关性分；账户名 / 订单号精确命中的图谱事实直接置顶&lt;br&gt;大模型调用失败 → 回退 ordered[:top_k]，不影响可用性" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2250" y="547" width="310" height="144" as="geometry"/></mxCell>
      <mxCell id="l3_selfrag" value="ai_self_rag_enabled 且&lt;br&gt;ai_self_rag_relevance_filter ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="731" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l3_selfrag_n" value="依据 backend/rag/pipeline.py ④.5 段&lt;br&gt;开 → ai_service.self_rag_filter_relevance() 对片段打 1~5 分，低于 ai_self_rag_relevance_threshold（默认 3）的被过滤&lt;br&gt;关 → 保留重排序结果，不做相关性过滤" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2250" y="731" width="310" height="123" as="geometry"/></mxCell>
      <mxCell id="l3_ctx" value="上下文构建 ContextBuilder.build()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="894" width="630" height="44" as="geometry"/></mxCell>
      <mxCell id="l3_ctx_n" value="参数 ai_rag_top_k（默认 4，注入条数上限）+ ai_rag_max_chars（默认 3000，注入总字数上限）　｜　按 top_k 条数与 max_chars 字数双重截断，渲染引用块（FAQ / 文档 / 图谱三种格式）　｜　被选中的 FAQ 命中次数 hit_count + 1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="958" width="630" height="81" as="geometry"/></mxCell>
      <mxCell id="g_l4" value="层级4 · 量化评估 ｜ backend/rag_eval.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#595959;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="3050" y="120" width="690" height="1370" as="geometry"/></mxCell>
      <mxCell id="l4_fixed" value="① 固定题集分层抽样&lt;br&gt;POST /api/ai/kb/eval/fixed-set" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3080" y="200" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l4_fixed_n" value="参数 sample_size 默认 10&lt;br&gt;_stratified_sample()：题型保底（fact / reason / compare 各至少 1 道）→ 角色保底（每个角色至少 1 道）→ 剩余名额按真实会话分布配额（_real_role_weights；真实样本 &lt; MIN_ROLE_SAMPLES=10 则退回均匀分配）&lt;br&gt;抽一次即固定并递增版本，写入 ai_eval_fixed_set（历史版本保留）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3400" y="200" width="310" height="186" as="geometry"/></mxCell>
      <mxCell id="l4_run" value="② 逐题跑「检索 + 生成」&lt;br&gt;POST /api/ai/kb/eval/run" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3080" y="426" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l4_run_n" value="role = random 时用固定题集，role = all / 空 时用全部启用题目&lt;br&gt;每题按自己的 role 走同一条链路：ModularRAG.query() + ai_service.chat()（temperature = 0.0，结果可复现）&lt;br&gt;图谱通道按题目角色取该角色的第一个真实账户作为 username" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3400" y="426" width="310" height="165" as="geometry"/></mxCell>
      <mxCell id="l4_score" value="③ 多指标打分&lt;br&gt;rag_eval.evaluate_rag()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3080" y="631" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l4_score_n" value="Context Precision（相关片段占比，阈值 0.65）+ Context Recall（标准答案句子被覆盖比例，阈值 0.65）&lt;br&gt;端到端：avg_similarity + Faithfulness + Answer Relevancy&lt;br&gt;语义模型 BAAI/bge-small-zh-v1.5（本地无缓存时回退千问 embedding API）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3400" y="631" width="310" height="165" as="geometry"/></mxCell>
      <mxCell id="l4_ab" value="④ A/B 对比&lt;br&gt;GET /api/ai/kb/eval/compare?a=&amp;b=" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3080" y="836" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l4_ab_n" value="对比两次评估的 5 个指标（检索精确率 / 检索召回率 / 端到端相似度 / 忠实度 / 答案相关性）及差值（B − A），并按 id 自动排序（旧的为 A）&lt;br&gt;结果带 config_snapshot —— 取 CONFIG_META 中「AI 知识库 / RAG 模块开关 / 查询优化 / Self-RAG」分组的参数快照" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3400" y="836" width="310" height="165" as="geometry"/></mxCell>
      <mxCell id="l4_hist" value="⑤ 历史留档&lt;br&gt;ai_eval_history、ai_eval_questions、ai_eval_fixed_set" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3080" y="1041" width="260" height="81" as="geometry"/></mxCell>
      <mxCell id="l4_hist_n" value="GET /eval/history、GET /eval/history/{eval_id}、GET /eval/last&lt;br&gt;每次评估自动写入 ai_eval_history（含 question_ids、fixed_set_version、config_snapshot、逐题明细）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3400" y="1041" width="310" height="123" as="geometry"/></mxCell>
      <mxCell id="l4_feedback" value="⑥ 诊断结论回灌系统参数&lt;br&gt;（依据 compare 的 diff 与 better）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3080" y="1204" width="260" height="60" as="geometry"/></mxCell>
      <mxCell id="l4_feedback_n" value="把得分低的环节定位到对应开关（如 Recall 低 → ai_query_rewrite_enabled / rag_module_graph_retrieval；Precision 低 → ai_rag_min_score / rag_rerank_source_bonus），改完再抽题 → 再评估，闭环回到第①步&lt;br&gt;这些开关都由 backend/config_service.py 的 CONFIG_META 定义；ModularRAG 每次查询都重新实例化，读到的即最新参数 —— 改完下一轮生效" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3400" y="1204" width="310" height="186" as="geometry"/></mxCell>
      <mxCell id="en0" value="用户查询进入&lt;br&gt;AI 对话接口：role 角色 + username 账户名" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="81" as="geometry"/></mxCell>
      <mxCell id="en1" value="Self-RAG 判断：本轮是否需要检索？&lt;br&gt;ai_self_rag_enabled&lt;br&gt;+ ai_self_rag_retrieve_check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="280" height="81" as="geometry"/></mxCell>
      <mxCell id="en2" value="否 → 跳过知识库检索&lt;br&gt;直接回答（省 embedding 调用）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="280" height="60" as="geometry"/></mxCell>
      <mxCell id="en3" value="ai_rag_enabled ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="280" height="44" as="geometry"/></mxCell>
      <mxCell id="en4" value="关 → build_faq_context()&lt;br&gt;只按关键词匹配问答库&lt;br&gt;（绕过本图整条链路）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="626" width="280" height="81" as="geometry"/></mxCell>
      <mxCell id="en5" value="username 的用途&lt;br&gt;图谱通道靠它把老板/打手的可见范围&lt;br&gt;收敛到本人；评估时按题目角色取&lt;br&gt;该角色的第一个真实账户" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="280" height="102" as="geometry"/></mxCell>
      <mxCell id="g1" value="ai_service.chat() 拼装 Prompt&lt;br&gt;（系统提示词 + 检索上下文 + 历史对话）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2670" y="200" width="300" height="60" as="geometry"/></mxCell>
