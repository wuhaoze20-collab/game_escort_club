      <mxCell id="g3" value="ai_self_rag_enabled&lt;br&gt;+ ai_self_rag_verify_answer ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2670" y="384" width="300" height="60" as="geometry"/></mxCell>
      <mxCell id="g4" value="self_rag_verify_answer()&lt;br&gt;校验回答是否被知识库支持&lt;br&gt;不支持则标记 issues" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2670" y="484" width="300" height="81" as="geometry"/></mxCell>
