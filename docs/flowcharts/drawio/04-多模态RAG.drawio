        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="r6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" target="r7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="为什么 image 必须单独占一路&lt;br&gt;（pipeline.py 注释里的原话）&lt;br&gt;&lt;br&gt;· 图注的语义分布与文档正文不同；&lt;br&gt;· 混进 document 通道，两边的相似度分数不可比；&lt;br&gt;· 也会让「图片这一路到底有没有被召回到」&lt;br&gt;  在调试信息里看不出来。&lt;br&gt;&lt;br&gt;注意：这是复用原有 RAG 管线的第三个向量通道，&lt;br&gt;不是新建的检索链路 —— 检索算法一个都没加。" vertex="1">
          <mxGeometry height="260" width="440" x="700" y="320" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="image 通道的权重从哪来&lt;br&gt;&lt;br&gt;ai_rag.CHANNEL_WEIGHT =&lt;br&gt;  {“document”: 1.0, “image”: 1.1, “faq”: 1.2, “graph”: 1.3}&lt;br&gt;&lt;br&gt;运行时由 _channel_weights(db) 读系统参数覆盖，&lt;br&gt;图片这一路读的是 rag_weight_image&lt;br&gt;（config_service.py 里它的 default 同为 1.1）。&lt;br&gt;调大更倾向返回图片，调小图片就排到文档后面。" vertex="1">
          <mxGeometry height="260" width="440" x="700" y="610" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="命中图片之后&lt;br&gt;&lt;br&gt;image 通道命中的 chunk 带 asset_path&lt;br&gt;（指向 kb_images/ 下的文件名），&lt;br&gt;前端据此拼 /kbimg/{文件名} 显示缩略图；&lt;br&gt;图注文本本身随 chunk.content 一起进上下文。" vertex="1">
          <mxGeometry height="180" width="440" x="700" y="900" as="geometry" />
