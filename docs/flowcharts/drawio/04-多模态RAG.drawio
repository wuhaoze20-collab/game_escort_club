        <mxCell id="n1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="缓存键 = 文件名 + 图片文件二进制 MD5&lt;br&gt;&lt;br&gt;· 图片没换 → 一次接口都不调；&lt;br&gt;· 图片换了内容（MD5 变）→ 只重算这一张；&lt;br&gt;· 反复点「重建索引」，图库没动 = 零花费。&lt;br&gt;&lt;br&gt;与 ai_chunks.content_hash 是两回事：&lt;br&gt;判断“要不要重调接口”看的是图片文件变没变，&lt;br&gt;不是图注文本变没变。" vertex="1">
          <mxGeometry height="260" width="360" x="900" y="170" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="图注结构（CAPTION_PROMPT 要求四段）&lt;br&gt;&lt;br&gt;一、一句话概括&lt;br&gt;二、画面内容（只描述看得见的）&lt;br&gt;三、图中文字：逐条抄录，检索的关键&lt;br&gt;四、关键信息：可用于检索的标签词&lt;br&gt;&lt;br&gt;为什么描述 + OCR + 标签一次产出：&lt;br&gt;分三次调用 = 三倍费用、三倍失败点；&lt;br&gt;千问 VL 本来就能在一次回答里一起给出。" vertex="1">
          <mxGeometry height="280" width="360" x="900" y="460" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="删除与重算（backend/api/ai_rag_api.py）&lt;br&gt;接口前缀 /api/ai/kb&lt;br&gt;&lt;br&gt;· POST /images/{file_name}/recaption&lt;br&gt;  强制重算：get_caption(..., force=True)&lt;br&gt;· DELETE /images/{file_name}&lt;br&gt;  删文件 + drop_caption() + drop_source()&lt;br&gt;&lt;br&gt;索引片段必须一起删，否则留下孤儿片段：&lt;br&gt;AI 还会引用它，前端却显示不出缩略图。" vertex="1">
          <mxGeometry height="250" width="360" x="900" y="780" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page3" name="02 检索侧：图片是独立的一路向量通道">
