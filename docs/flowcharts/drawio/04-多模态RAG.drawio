        <mxCell id="r4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" value="每个通道只返回自己那一类的候选，互不混合&lt;br&gt;all_vec_hits 里用 channel 字段标记这条来自哪一路" vertex="1">
