      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" value="检索侧：图片单独占一路向量通道 source_types=[“image”]，与 document 不混合；融合时 image 通道乘自己的权重&lt;br&gt;依据 backend/rag/pipeline.py · backend/rag/vector_retriever.py · backend/rag/fusion.py · backend/ai_rag.py CHANNEL_WEIGHT / _channel_weights() · backend/config_service.py rag_weight_image" vertex="1">
          <mxGeometry height="48" width="1160" x="40" y="16" as="geometry" />
