<diagram id="page1" name="00 模块化RAG编排总览（ModularRAG）">
  <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1510" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="t1" value="模块化 RAG 编排总览：ModularRAG 组装了哪些模块、query() 的执行顺序、模块开关与生成边界 —— 代码依据 backend/rag/pipeline.py" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1140" height="34" as="geometry"/></mxCell>
      <mxCell id="n_in" value="用户提问 question + role + username" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="300" height="44" as="geometry"/></mxCell>
      <mxCell id="n_sw" value="读取 7 个模块开关&lt;br&gt;（ai_rag.py module_*_enabled，每次查询重新读取）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="165" width="340" height="60" as="geometry"/></mxCell>
      <mxCell id="n_rw" value="① 查询改写 QueryRewriter.rewrite()&lt;br&gt;同义词扩展 / 分解 / 后退 / HyDE / 多查询" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="360" height="60" as="geometry"/></mxCell>
      <mxCell id="n_multi" value="② 多路召回 Multi-Retrieval&lt;br&gt;每个查询变体各跑一遍关键词 + 向量；图谱只用原始问题" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="375" width="360" height="60" as="geometry"/></mxCell>
      <mxCell id="k_kw" value="KeywordRetriever.retrieve()&lt;br&gt;FAQ BM25 关键词匹配&lt;br&gt;（开关 rag_module_keyword_retrieval）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="290" height="81" as="geometry"/></mxCell>
      <mxCell id="k_vec" value="VectorRetriever.retrieve()&lt;br&gt;document / image / faq 三通道独立召回&lt;br&gt;（开关 rag_module_vector_retrieval）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="490" width="340" height="81" as="geometry"/></mxCell>
      <mxCell id="k_graph" value="GraphRetriever.retrieve()&lt;br&gt;仅用原始问题（实体链接）&lt;br&gt;（开关 rag_module_graph_retrieval）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="490" width="300" height="81" as="geometry"/></mxCell>
      <mxCell id="n_empty" value="三路结果全空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="620" width="260" height="110" as="geometry"/></mxCell>
      <mxCell id="n_ret_empty" value="返回空字符串（不注入参考资料）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="630" width="280" height="44" as="geometry"/></mxCell>
      <mxCell id="n_fuse" value="③ 结果融合 FusionModule.fuse()&lt;br&gt;加权 RRF（rag_rrf_k）&lt;br&gt;（开关 rag_module_fusion）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="770" width="360" height="81" as="geometry"/></mxCell>
      <mxCell id="n_rmode" value="④ 重排序模式&lt;br&gt;rag_rerank_mode = rule | semantic&lt;br&gt;（开关 rag_module_rerank）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="880" width="280" height="110" as="geometry"/></mxCell>
      <mxCell id="r_rule" value="Reranker.rerank()（rule，默认）&lt;br&gt;RRF分 + 向量分 + 关键词分 + 来源加成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="320" height="60" as="geometry"/></mxCell>
      <mxCell id="r_sem" value="CrossEncoderReranker.rerank()（semantic）&lt;br&gt;调大模型逐条打相关性分（多 1 次 API 调用）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="900" width="340" height="60" as="geometry"/></mxCell>
      <mxCell id="n_selfrag" value="④.5 Self-RAG 相关性过滤？&lt;br&gt;ai_self_rag_enabled + ai_self_rag_relevance_filter" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="1030" width="360" height="110" as="geometry"/></mxCell>
      <mxCell id="s_filter" value="ai_service.self_rag_filter_relevance()&lt;br&gt;ISREL 打分 1~5，过滤 ≤ 阈值的片段" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1050" width="320" height="60" as="geometry"/></mxCell>
      <mxCell id="n_debug" value="⑤ 填充调试信息 _fill_debug()&lt;br&gt;（前端「RAG 调试」页展示检索全过程）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1180" width="360" height="60" as="geometry"/></mxCell>
      <mxCell id="n_ctx" value="⑥ 上下文构建 ContextBuilder.build()&lt;br&gt;渲染引用块（受 top_k / max_chars 限制）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1290" width="360" height="60" as="geometry"/></mxCell>
      <mxCell id="n_ret" value="返回格式化上下文文本 str&lt;br&gt;（query() 只做「检索 + 增强」）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1400" width="320" height="60" as="geometry"/></mxCell>
      <mxCell id="n_gen" value="生成 Generate 不在本类&lt;br&gt;backend/ai_service.py chat()：&lt;br&gt;拼 Prompt → 千问大模型生成答案" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1310" width="320" height="81" as="geometry"/></mxCell>
      <mxCell id="n_ans" value="返回答案给用户" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1420" width="320" height="44" as="geometry"/></mxCell>
      <mxCell id="note_mod" value="ModularRAG.__init__ 组装的模块（pipeline.py）&lt;br&gt;· rewriter = QueryRewriter&lt;br&gt;· vector_retriever = VectorRetriever&lt;br&gt;· keyword_retriever = KeywordRetriever&lt;br&gt;· graph_retriever = GraphRetriever&lt;br&gt;· fusion = FusionModule(rrf_k, channel_weights)&lt;br&gt;· reranker = Reranker&lt;br&gt;· cross_encoder = CrossEncoderReranker&lt;br&gt;  （与 reranker 二选一）&lt;br&gt;· context_builder = ContextBuilder" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="70" width="420" height="228" as="geometry"/></mxCell>
      <mxCell id="note_sw" value="模块开关（ai_rag.py 读取，可独立关闭）&lt;br&gt;· rag_module_query_rewrite&lt;br&gt;· rag_module_vector_retrieval&lt;br&gt;· rag_module_keyword_retrieval&lt;br&gt;· rag_module_graph_retrieval&lt;br&gt;· rag_module_fusion&lt;br&gt;· rag_module_rerank&lt;br&gt;· rag_module_automerge&lt;br&gt;关闭后果：&lt;br&gt;· fusion 降级 _simple_merge()&lt;br&gt;· rerank 降级直接用融合结果" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="320" width="420" height="249" as="geometry"/></mxCell>
      <mxCell id="note_param" value="融合 / 重排相关参数&lt;br&gt;· rag_rrf_k —— RRF 平滑常数&lt;br&gt;· rag_weight_document / _image / _faq / _graph&lt;br&gt;· rag_rerank_mode = rule | semantic&lt;br&gt;· ai_self_rag_enabled / ai_self_rag_relevance_filter" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="590" width="420" height="123" as="geometry"/></mxCell>
      <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_in" target="n_sw"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="n_sw" target="n_rw"><mxGeometry relative="1" as="geometry"/></mxCell>
