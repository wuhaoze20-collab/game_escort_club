<diagram id="page3" name="02 backend-kg模块与整体分层">
  <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="t3" value="backend/kg/ 模块与整体分层：包内依赖 · 图谱层与 RAG 层的单向依赖 · 存储分层（MySQL / 向量库 / Neo4j）—— 依据 backend/kg/*.py" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1180" height="34" as="geometry"/></mxCell>
      <mxCell id="lg3" value="实线 = import / 调用依赖；虚线 = 说明性引用" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="34" width="420" height="30" as="geometry"/></mxCell>
      <mxCell id="z1" value="① backend/kg/ 包内依赖" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="205" width="700" height="30" as="geometry"/></mxCell>
      <mxCell id="z2" value="② 图谱层 ↔ RAG 层（rag 向下依赖 kg，反向不存在）" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="z3" value="③ 存储分层" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="caller_rebuild" value="POST /api/kg/rebuild（仅管理员）" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="340" height="51" as="geometry"/></mxCell>
      <mxCell id="caller_incr" value="main.py 启动 init_knowledge_graph()&lt;br&gt;下单 / 评价 / 打赏 / 提现 等接口&lt;br&gt;→ sync.sync_order / sync_rating / sync_tip / ..." style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="400" height="93" as="geometry"/></mxCell>
      <mxCell id="kg_api" value="kg/api.py&lt;br&gt;FastAPI router，前缀 /api/kg&lt;br&gt;5 个端点：stats / graph / node / search / rebuild" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="360" height="81" as="geometry"/></mxCell>
      <mxCell id="kg_init" value="kg/__init__.py&lt;br&gt;from . import store, schema, sync" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="360" height="60" as="geometry"/></mxCell>
      <mxCell id="kg_sync" value="kg/sync.py&lt;br&gt;从 MySQL 业务表同步到图谱&lt;br&gt;sync_all / sync_order / sync_rating /&lt;br&gt;sync_tip / sync_withdrawal / sync_punishments" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="240" width="380" height="102" as="geometry"/></mxCell>
      <mxCell id="kg_schema" value="kg/schema.py&lt;br&gt;图谱字典：节点 / 关系 / 字段&lt;br&gt;敏感字段标注（fields 第二项）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="240" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="rag_graph" value="rag/graph_retriever.py&lt;br&gt;RAG 的图谱召回通道（第三路）&lt;br&gt;实体链接 → 一跳邻域 → 渲染事实" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="kg_store" value="kg/store.py&lt;br&gt;Neo4j 连接封装&lt;br&gt;run() / run_safe() / stats()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="note_nodep" value="kg/schema.py 模块级无 import&lt;br&gt;（纯常量定义，不依赖任何模块）" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="420" width="360" height="60" as="geometry"/></mxCell>
      <mxCell id="mysql" value="MySQL（业务真相源）&lt;br&gt;models.py：User / BossInfo / PlayerInfo /&lt;br&gt;Order / PlayerRating / TipRecord / ..." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="neo4j" value="Neo4j 知识图谱&lt;br&gt;bolt://127.0.0.1:7687&lt;br&gt;（旁路：写失败只打日志）" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="590" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="vecdb" value="向量库（只服务 rag 检索）&lt;br&gt;Chroma（主用）/ Qdrant（对比）&lt;br&gt;kg 层不涉及向量库" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="590" width="380" height="81" as="geometry"/></mxCell>
      <mxCell id="note_store" value="分层约定&lt;br&gt;· MySQL —— 业务真相源；图谱与向量库都由它派生&lt;br&gt;· 向量库 —— 只被 rag 的 VectorRetriever 读取&lt;br&gt;· Neo4j —— 图谱旁路，所有写入走 store.run_safe()，失败不致命&lt;br&gt;· 依赖单向：rag/graph_retriever.py → kg.store；kg 层不 import rag" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="760" height="123" as="geometry"/></mxCell>
      <mxCell id="e1" value="HTTP 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="caller_rebuild" target="kg_api"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e2" value="增量同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="caller_incr" target="kg_sync"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" value="rebuild → sync_all()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_api" target="kg_sync"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" value="stats / graph 查询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_api" target="kg_store"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e5" value="字段中文名 / 敏感标注" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kg_api" target="kg_schema"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e6" value="from . import store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_init" target="kg_store"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="from . import schema" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;exitX=1.0;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kg_init" target="kg_schema"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e8" value="from . import sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_init" target="kg_sync"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e9" value="store.run_safe()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_sync" target="kg_store"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e10" value="schema.NODE_TYPES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_sync" target="kg_schema"><mxGeometry relative="1" as="geometry"/></mxCell>
