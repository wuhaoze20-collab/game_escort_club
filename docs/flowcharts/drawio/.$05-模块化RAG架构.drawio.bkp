      <mxCell id="e12" value="neo4j.GraphDatabase.driver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="kg_store" target="neo4j"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;dashed=1;" edge="1" parent="1" source="kg_schema" target="note_nodep"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e14" value="from kg import store（单向依赖）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#666666;strokeWidth=1;fontSize=12;fontFamily=Microsoft YaHei;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;" edge="1" parent="1" source="rag_graph" target="kg_store"><mxGeometry relative="1" as="geometry"/></mxCell>
