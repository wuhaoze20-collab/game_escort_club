<diagram id="page2" name="01 backend-rag模块依赖与数据流">
  <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="990" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="t2" value="backend/rag/ 模块依赖与数据流：模块级 import 关系 · Document 数据载体 · chroma_store / qdrant_store 双后端 · 谁读 MySQL 谁读向量库 —— 依据 backend/rag/*.py" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1080" height="34" as="geometry"/></mxCell>
      <mxCell id="lg" value="实线 = 模块级 import / 调用依赖；虚线 = 运行时延迟导入 / 旁路或说明性引用" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="30" width="520" height="30" as="geometry"/></mxCell>
      <mxCell id="z1" value="① rag 包内部依赖：pipeline.py 是唯一编排者" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="z2" value="② 跨包 / 外部依赖与数据来源" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Microsoft YaHei;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="900" height="30" as="geometry"/></mxCell>
